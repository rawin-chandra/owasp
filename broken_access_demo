<h2>Scenario 2 — Privilege Escalation (Mass Assignment)</h2>
<p style="color:#666;font-size:14px">แก้ role ตัวเองเป็น admin ผ่าน request body</p>

<div class="card danger">
    <span class="label-d">❌ VULNERABLE</span>
    <h3 style="margin-top:0">รับ role จาก request body โดยตรง</h3>

    <div class="attack-box">
        <strong>Attack:</strong> bob ส่ง PATCH พร้อม <code>"role": "admin"</code>
        ใน body — server update ทุก field โดยไม่กรอง
    </div>

    <form method="POST">
        <input type="hidden" name="scenario" value="priv_vuln">
        <input type="hidden" name="name" value="bob">
        <input type="hidden" name="email" value="bob@email.com">
        <input type="hidden" name="role" value="admin">
        <button type="submit" class="btn-d">PATCH /users/me (body: role=admin)</button>
    </form>

    <?php
    if (($_POST['scenario'] ?? '') === 'priv_vuln') {
        // ❌ รับทุก field จาก $_POST โดยตรง (Mass Assignment)
        $update = $_POST;
        unset($update['scenario']);

        echo "<div class='result-d'>
            <strong>⚠ 200 OK — role ถูกอัปเดตเป็น:</strong> " . htmlspecialchars($update['role'] ?? '') . "<br>
            <small>bob เพิ่งยกระดับตัวเองเป็น admin ได้!</small>
        </div>";
        echo "<pre>" . htmlspecialchars(json_encode($update, JSON_PRETTY_PRINT)) . "</pre>";
    }
    ?>

    <pre><span class="cmt">// ❌ Vulnerable — อัปเดตทุก field ที่รับมา</span>
<span class="bad">$data = $_POST;           // รับทั้งหมดจาก body
$pdo->prepare("UPDATE users SET name=?, email=?, role=? WHERE id=?")
    ->execute([$data['name'], $data['email'], $data['role'], $_SESSION['user_id']]);
// attacker ส่ง role=admin → กลายเป็น admin ทันที!</span></pre>
</div>

<div class="card safe">
    <span class="label-s">✅ SAFE</span>
    <h3 style="margin-top:0">ใช้ allowlist — รับเฉพาะ field ที่อนุญาต</h3>

    <form method="POST">
        <input type="hidden" name="scenario" value="priv_safe">
        <input type="hidden" name="name" value="bob">
        <input type="hidden" name="email" value="bob@email.com">
        <input type="hidden" name="role" value="admin">
        <button type="submit" class="btn-s">PATCH /users/me (Safe)</button>
    </form>

    <?php
    if (($_POST['scenario'] ?? '') === 'priv_safe') {
        // ✓ allowlist — รับเฉพาะ name และ email เท่านั้น
        $allowed = ['name', 'email'];
        $safe = array_intersect_key($_POST, array_flip($allowed));

        echo "<div class='result-s'>
            ✓ 200 OK — อัปเดตได้เฉพาะ field ที่อนุญาต:<br>
            " . htmlspecialchars(json_encode($safe)) . "<br>
            <strong>role ไม่ถูกแตะต้อง</strong> — bob ยังเป็น user
        </div>";
    }
    ?>

    <pre><span class="cmt">// ✓ Safe — allowlist field ที่อนุญาต</span>
<span class="ok">$allowed = ['name', 'email'];  // role ไม่อยู่ใน list
$safe    = array_intersect_key($_POST, array_flip($allowed));

