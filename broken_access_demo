    }
    ?>

    <pre><span class="cmt">// ✓ Safe — ทุก method ผ่าน requireAdmin</span>
<span class="ok">function requireAdmin(): void {
    if ($_SESSION['role'] !== 'admin') {
        http_response_code(403);
        echo json_encode(['error' => 'Forbidden']);
        exit;
    }
}

// ใช้กับทุก method
