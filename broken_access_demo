<script>
const BASE = window.location.origin;

async function fetchIDOR(safe) {
    const id  = document.getElementById(safe ? 'idor-safe-id' : 'idor-id').value;
    const url = BASE + `/api/orders/${id}` + (safe ? '?safe=1' : '');
    const el  = document.getElementById(safe ? 'idor-safe-res' : 'idor-vuln-res');
    el.textContent = 'Loading...';
    try {
        const r = await fetch(url);
        const j = await r.json();
        el.textContent = `HTTP ${r.status}\n` + JSON.stringify(j, null, 2);
        el.className = 'response-box ' + (r.ok && !j.error ? 'error' : 'success');
    } catch(e) { el.textContent = 'Error: ' + e.message; }
}

async function sendUpdate(safe) {
    const el = document.getElementById(safe ? 'mass-safe-res' : 'mass-vuln-res');
    const fd = new FormData();
    fd.append('username', 'bob');
    fd.append('email', 'bob@site.com');
    fd.append('role', 'admin');        // ← payload
    if (safe) fd.append('safe', '1');
    el.textContent = 'Loading...';
    try {
        const r = await fetch(BASE + '/api/users/me', { method:'POST', body: fd });
        const j = await r.json();
        el.textContent = `HTTP ${r.status}\n` + JSON.stringify(j, null, 2);
        el.className = 'response-box ' + (safe ? 'success' : 'error');
    } catch(e) { el.textContent = 'Error: ' + e.message; }
}

async function fetchAdmin(safe) {
    const el  = document.getElementById(safe ? 'method-safe-res' : 'method-vuln-res');
    const url = BASE + '/admin/users' + (safe ? '?safe=1' : '');
    el.textContent = 'Loading...';
    try {
        const r = await fetch(url);
        const j = await r.json();
        el.textContent = `HTTP ${r.status}\n` + JSON.stringify(j, null, 2);
        el.className = 'response-box ' + (r.status === 403 ? 'success' : 'error');
    } catch(e) { el.textContent = 'Error: ' + e.message; }
}

async function fetchReport(safe) {
    const el  = document.getElementById(safe ? 'browse-safe-res' : 'browse-vuln-res');
    const url = BASE + '/admin/report' + (safe ? '?safe=1' : '');
    el.textContent = 'Loading...';
    try {
        const r = await fetch(url);
        const j = await r.json();
        el.textContent = `HTTP ${r.status}\n` + JSON.stringify(j, null, 2);
        el.className = 'response-box ' + (r.status === 403 ? 'success' : 'error');
    } catch(e) { el.textContent = 'Error: ' + e.message; }
}
</script>
