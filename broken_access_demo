<?php
/**
 * A01:2021 — Broken Access Control
 * Vanilla PHP — ง่าย ไม่ซับซ้อน
 */

session_start();

// จำลอง user ที่ login: bob (user ทั่วไป)
$_SESSION['user_id'] = 2;
$_SESSION['role']    = 'user';

// จำลองข้อมูล
$orders = [
    1 => ['id'=>1, 'user_id'=>1, 'item'=>'MacBook', 'email'=>'alice@mail.com'],
    2 => ['id'=>2, 'user_id'=>2, 'item'=>'AirPods',  'email'=>'bob@mail.com'],
    3 => ['id'=>3, 'user_id'=>3, 'item'=>'iPhone',   'email'=>'carol@mail.com'],
];
$users = [
    1 => ['id'=>1, 'name'=>'Alice', 'role'=>'admin', 'salary'=>120000],
    2 => ['id'=>2, 'name'=>'Bob',   'role'=>'user',  'salary'=>45000],
    3 => ['id'=>3, 'name'=>'Carol', 'role'=>'user',  'salary'=>52000],
];

// รับค่าจากฟอร์ม
$scenario = $_GET['scenario'] ?? $_POST['scenario'] ?? '';
$result   = '';

// ─────────────────────────────────────
// SCENARIO 1: IDOR
// ─────────────────────────────────────
if ($scenario === 'idor_bad') {
    $id    = (int)$_GET['id'];

    // ❌ ไม่ตรวจว่า order เป็นของ user นี้ไหม
    $order = $orders[$id] ?? null;
    $result = $order
        ? "⚠️ ได้ข้อมูล: " . $order['item'] . " | " . $order['email']
        : "ไม่พบ order";
}

if ($scenario === 'idor_good') {
    $id    = (int)$_GET['id'];
    $order = $orders[$id] ?? null;

    // ✓ ตรวจ ownership ก่อน
    if (!$order || $order['user_id'] !== $_SESSION['user_id']) {
        $result = "✅ 403 Forbidden — ไม่ใช่ order ของคุณ";
    } else {
        $result = "✅ " . $order['item'];
    }
}

// ─────────────────────────────────────
// SCENARIO 2: MASS ASSIGNMENT
// ─────────────────────────────────────
if ($scenario === 'mass_bad') {
    // ❌ รับ role จาก body โดยตรง
    $role   = $_POST['role'];
    $result = "⚠️ role ถูกอัปเดตเป็น: $role (bob กลายเป็น admin!)";
}

if ($scenario === 'mass_good') {
    // ✓ allowlist — รับแค่ name, email
    $allowed = ['name', 'email'];
    $safe    = array_intersect_key($_POST, array_flip($allowed));
    $result  = "✅ อัปเดตแค่: " . implode(', ', array_keys($safe)) . " — role ไม่เปลี่ยน";
}

// ─────────────────────────────────────
// SCENARIO 3: METHOD BYPASS
// ─────────────────────────────────────
if ($scenario === 'method_bad') {
    // ❌ ไม่ตรวจ role ใน GET
    $result = "⚠️ ข้อมูล users ทั้งหมด: " .
        implode(', ', array_column(array_values($users), 'name')) .
        " | salary: " . implode(', ', array_column(array_values($users), 'salary'));
}

if ($scenario === 'method_good') {
    // ✓ ตรวจ role ทุก method
    if ($_SESSION['role'] !== 'admin') {
        $result = "✅ 403 Forbidden — bob ไม่มีสิทธิ์";
    } else {
        $result = "OK — admin เข้าได้";
    }
}
?>
