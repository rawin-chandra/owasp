<div class="card safe">
    <span class="label-s">✅ SAFE</span>
    <h3 style="margin-top:0">ตรวจสอบ session + role ทุกครั้ง</h3>

    <pre><span class="cmt">// ✓ Safe — ใช้ middleware ทุก sensitive endpoint</span>
<span class="ok">function requireLogin(): void {
    if (empty($_SESSION['user_id'])) {
        http_response_code(401);
        header('Location: /login');
        exit;
    }
}

function requireAdmin(): void {
    requireLogin();
    if ($_SESSION['role'] !== 'admin') {
        http_response_code(403);
        exit;
    }
}

// Apply ทุก route ที่ต้องการ
Router::get('/api/export', 'requireAdmin', 'exportData');</span></pre>
</div>

