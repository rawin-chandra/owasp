        // ❌ ไม่ตรวจสอบ session / token เลย
        echo "<div class='result-d'>⚠ 200 OK — ข้อมูลทั้งหมดถูก export โดยไม่ต้อง login!</div>";
        echo "<pre>" . json_encode(array_values($fake_users), JSON_PRETTY_PRINT) . "</pre>";
    }
    ?>

    <pre><span class="bad">// ❌ Vulnerable
public function export() {
    // ไม่มีการตรวจสอบ session เลย!
    $users = User::all();
    return response()->json($users);
}</span></pre>
