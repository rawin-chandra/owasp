</div>

<div class="card safe">
    <span class="label-s">✅ SAFE</span>
    <h3 style="margin-top:0">ทุก method ต้องผ่าน middleware</h3>

    <form method="GET">
        <input type="hidden" name="scenario" value="method_safe">
        <button type="submit" class="btn-s">GET /admin/users (มี middleware)</button>
    </form>

    <?php
    if (($_GET['scenario'] ?? '') === 'method_safe') {
        // ✓ ตรวจสอบ role ทุก method
        if ($_SESSION['role'] !== 'admin') {
            echo "<div class='result-s'>
                <strong>403 Forbidden</strong><br>
