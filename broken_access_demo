        <button type="submit" class="btn-d">GET /admin/users (ลืมใส่ middleware)</button>
    </form>

    <?php
    if (($_GET['scenario'] ?? '') === 'method_vuln') {
        // ❌ ไม่ตรวจสอบ role สำหรับ GET request
        echo "<div class='result-d'>⚠ 200 OK — ข้อมูล users ทั้งหมดรั่ว!</div>";
        echo "<table>
            <tr><th>id</th><th>username</th><th>role</th><th>email</th><th>salary ⚠</th></tr>";
        foreach ($fake_users as $u) {
            echo "<tr>
                <td>{$u['id']}</td>
                <td>" . htmlspecialchars($u['username']) . "</td>
                <td>{$u['role']}</td>
                <td>" . htmlspecialchars($u['email']) . "</td>
                <td style='color:#c0392b'>" . number_format($u['salary']) . " บาท</td>
            </tr>";
        }
        echo "</table>";
    }
    ?>

    <pre><span class="cmt">// ❌ Vulnerable — POST ตรวจ role แต่ GET ลืมตรวจ</span>
<span class="bad">// POST /admin/users → มี requireAdmin() middleware
Router::post('/admin/users', 'requireAdmin', 'createUser');

// GET /admin/users → ลืมใส่ middleware!
