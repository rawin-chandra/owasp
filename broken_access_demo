<?php
/**
 * =====================================================
 *  A01:2021 — Broken Access Control
 *  Vanilla PHP เท่านั้น — ไม่ใช้ Framework
 * =====================================================
 *  4 Scenarios:
 *  1. IDOR       — ดูข้อมูลคนอื่นผ่าน ID
 *  2. Mass Assignment — เพิ่มสิทธิ์ตัวเองเป็น admin
 *  3. Method Bypass   — GET เข้า admin endpoint
 *  4. Force Browse    — เดา URL admin โดยตรง
 * =====================================================
 */

session_start();

// ─────────────────────────────────────────────────────
// จำลอง Database
// ─────────────────────────────────────────────────────
$USERS = [
    1 => ['id'=>1,'username'=>'alice','role'=>'admin','email'=>'alice@site.com','salary'=>120000],
    2 => ['id'=>2,'username'=>'bob',  'role'=>'user', 'email'=>'bob@site.com',  'salary'=>45000],
    3 => ['id'=>3,'username'=>'carol','role'=>'user', 'email'=>'carol@site.com','salary'=>52000],
];
$ORDERS = [
    1 => ['id'=>1,'user_id'=>1,'item'=>'MacBook Pro', 'price'=>89000,'email'=>'alice@site.com'],
    2 => ['id'=>2,'user_id'=>2,'item'=>'AirPods',     'price'=>7900, 'email'=>'bob@site.com'],
    3 => ['id'=>3,'user_id'=>3,'item'=>'iPhone 15',   'price'=>39900,'email'=>'carol@site.com'],
    4 => ['id'=>4,'user_id'=>1,'item'=>'iPad Pro',    'price'=>35900,'email'=>'alice@site.com'],
];

// จำลอง session: bob login อยู่ (user ทั่วไป)
if (empty($_SESSION['user_id'])) {
    $_SESSION['user_id'] = 2;
    $_SESSION['username'] = 'bob';
    $_SESSION['role'] = 'user';
}

// ─────────────────────────────────────────────────────
// Helper Functions
// ─────────────────────────────────────────────────────

/** Middleware — ตรวจ login */
function requireLogin(): void {
    if (empty($_SESSION['user_id'])) {
        http_response_code(401);
        die('<div class="result-s"><strong>401 Unauthorized</strong> — กรุณา login ก่อน</div>');
    }
}

/** Middleware — ตรวจ admin */
function requireAdmin(): void {
    requireLogin();
    if ($_SESSION['role'] !== 'admin') {
        http_response_code(403);
        die('<div class="result-s"><strong>403 Forbidden</strong> — คุณไม่มีสิทธิ์ admin</div>');
    }
}

/** ดึง route จาก URL */
function getRoute(): string {
    $uri = parse_url($_SERVER['REQUEST_URI'], PHP_URL_PATH);
    return rtrim($uri, '/') ?: '/';
}

$method = $_SERVER['REQUEST_METHOD'];
$route  = getRoute();

// ─────────────────────────────────────────────────────
// Simple Router — จัดการ route ต่างๆ
// ─────────────────────────────────────────────────────

// ── /api/orders/{id} — IDOR Scenario ──────────────────
if ($method === 'GET' && preg_match('#^/api/orders/(\d+)$#', $route, $m)) {
    requireLogin();
    $order_id = (int)$m[1];
    $safe     = isset($_GET['safe']);
    $order    = $ORDERS[$order_id] ?? null;

    header('Content-Type: application/json');

    if (!$order) {
        http_response_code(404);
        echo json_encode(['error' => 'Not found']);
        exit;
    }

    if ($safe) {
        // ✓ Safe: ตรวจสอบ ownership
        if ($order['user_id'] !== $_SESSION['user_id']) {
            http_response_code(403);
            echo json_encode(['error' => 'Forbidden — this order belongs to another user']);
            exit;
        }
    }
    // ❌ Vulnerable: คืนข้อมูลโดยไม่ตรวจ ownership
    echo json_encode($order);
    exit;
}

// ── /api/users/me — Mass Assignment Scenario ──────────
if ($method === 'POST' && $route === '/api/users/me') {
    requireLogin();
    $safe  = isset($_POST['safe']);
    $input = $_POST;
    unset($input['safe']);

    header('Content-Type: application/json');

    if ($safe) {
        // ✓ Safe: allowlist
        $allowed = ['username', 'email'];
        $updated = array_intersect_key($input, array_flip($allowed));
        echo json_encode(['message' => 'Updated (safe)', 'data' => $updated]);
    } else {
        // ❌ Vulnerable: รับทุก field รวมถึง role
        echo json_encode(['message' => 'Updated (vulnerable)', 'data' => $input]);
    }
    exit;
}

// ── /admin/users — Method Bypass Scenario ─────────────
if ($route === '/admin/users') {
    header('Content-Type: application/json');

    if ($method === 'POST') {
        // POST มี middleware
        requireAdmin();
        echo json_encode(['message' => 'User created']);
    } elseif ($method === 'GET') {
        $safe = isset($_GET['safe']);

        if ($safe) {
            // ✓ Safe: GET ก็มี middleware
            requireAdmin();
        }
        // ❌ Vulnerable: GET ไม่มี middleware — ใครก็ดึงข้อมูลได้
        global $USERS;
        echo json_encode(array_values($USERS));
    }
    exit;
}

// ── /admin/report — Force Browse Scenario ─────────────
if ($method === 'GET' && $route === '/admin/report') {
    header('Content-Type: application/json');
    $safe = isset($_GET['safe']);

    if ($safe) {
        requireAdmin();
    }
    // ❌ Vulnerable: ไม่มีการตรวจสอบ — เดา URL มาตรงก็เข้าได้
    global $USERS;
    $report = array_map(fn($u) => [
        'username' => $u['username'],
        'salary'   => $u['salary'],
        'role'     => $u['role'],
    ], $USERS);
    echo json_encode(['report' => array_values($report)]);
    exit;
}

?>
