<!-- ═══════════════════════════════════
     SCENARIO 1: IDOR
═══════════════════════════════════ -->
<h2>Scenario 1 — IDOR</h2>
<p class="sub">bob มีแค่ order #2 แต่ลองเปลี่ยน ID เพื่อดูของคนอื่น</p>

<div class="card danger">
    <span class="ld">❌ VULNERABLE</span>
    <h3 style="margin-top:0">GET /api/orders/{id} — ไม่ตรวจ ownership</h3>
    <div class="attack-box">
        <strong>ลอง:</strong> เปลี่ยน ID เป็น 1, 3, 4 เพื่อดูข้อมูลของ alice และ carol
    </div>
    Order ID: <input type="number" id="idor-id" value="1" min="1" max="4">
    <button class="btn-d" onclick="fetchIDOR(false)">GET /api/orders/{id}</button>
    <div class="response-box" id="idor-vuln-res">กด button เพื่อทดสอบ</div>

    <pre><span class="cmt">// ❌ Vulnerable — คืน order ตาม ID โดยไม่ตรวจว่าเป็นของ user นี้ไหม</span>
<span class="bad">$order_id = (int)$_GET['id'];
$stmt     = $pdo->prepare("SELECT * FROM orders WHERE id = ?");
$stmt->execute([$order_id]);
$order    = $stmt->fetch();     // ← ไม่ตรวจ user_id เลย
echo json_encode($order);</span></pre>
</div>

<div class="card safe">
    <span class="ls">✅ SAFE</span>
    <h3 style="margin-top:0">ตรวจสอบ ownership ก่อนคืนข้อมูล</h3>
    Order ID: <input type="number" id="idor-safe-id" value="1" min="1" max="4">
    <button class="btn-s" onclick="fetchIDOR(true)">GET /api/orders/{id} (Safe)</button>
    <div class="response-box" id="idor-safe-res">กด button เพื่อทดสอบ</div>

    <pre><span class="cmt">// ✓ Safe — WHERE ทั้ง id และ user_id พร้อมกัน</span>
<span class="ok">$stmt = $pdo->prepare(
    "SELECT * FROM orders WHERE id = ? AND user_id = ?"
);
$stmt->execute([$order_id, $_SESSION['user_id']]);
$order = $stmt->fetch();

if (!$order) {
    http_response_code(403);
    echo json_encode(['error' => 'Forbidden']);
    exit;
}</span></pre>
</div>

<!-- ═══════════════════════════════════
     SCENARIO 2: MASS ASSIGNMENT
═══════════════════════════════════ -->
<h2>Scenario 2 — Mass Assignment (Privilege Escalation)</h2>
<p class="sub">bob ส่ง role=admin ใน POST body เพื่อยกระดับสิทธิ์ตัวเอง</p>

<div class="card danger">
    <span class="ld">❌ VULNERABLE</span>
    <h3 style="margin-top:0">POST /api/users/me — รับ role จาก body โดยตรง</h3>
    <div class="attack-box">
        <strong>Attack payload:</strong> <code>{username:"bob", email:"bob@site.com", role:"admin"}</code>
    </div>
    <button class="btn-d" onclick="sendUpdate(false)">POST /api/users/me (role=admin)</button>
    <div class="response-box" id="mass-vuln-res">กด button เพื่อทดสอบ</div>

    <pre><span class="cmt">// ❌ Vulnerable — รับทุก field จาก $_POST</span>
<span class="bad">$data = $_POST;   // รวม role ด้วย!
$pdo->prepare("UPDATE users SET username=?, email=?, role=? WHERE id=?")
    ->execute([$data['username'], $data['email'],
               $data['role'], $_SESSION['user_id']]);</span></pre>
</div>

<div class="card safe">
    <span class="ls">✅ SAFE</span>
    <h3 style="margin-top:0">Allowlist — รับเฉพาะ field ที่อนุญาต</h3>
    <button class="btn-s" onclick="sendUpdate(true)">POST /api/users/me (Safe)</button>
    <div class="response-box" id="mass-safe-res">กด button เพื่อทดสอบ</div>

    <pre><span class="cmt">// ✓ Safe — กรอง field ด้วย allowlist</span>
<span class="ok">$allowed = ['username', 'email'];
$safe    = array_intersect_key($_POST, array_flip($allowed));

$pdo->prepare("UPDATE users SET username=?, email=? WHERE id=?")
    ->execute([$safe['username'], $safe['email'],
               $_SESSION['user_id']]);
// role ถูกทิ้งไปโดยอัตโนมัติ</span></pre>
</div>

