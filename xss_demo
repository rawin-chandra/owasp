<?php
/**
 * =====================================================
 *  Cross-Site Scripting (XSS) Demo — PHP
 *  แสดงช่องโหว่ทั้ง 3 ประเภทและวิธีแก้ไข
 * =====================================================
 *  1. Reflected XSS  — ค่าจาก URL สะท้อนกลับทันที
 *  2. Stored XSS     — บันทึกลง "DB" แล้วแสดงซ้ำ
 *  3. DOM-based XSS  — JavaScript อ่าน URL เอง
 * =====================================================
 */

session_start();

// จำลอง "database" ใน session
if (!isset($_SESSION['comments'])) {
    $_SESSION['comments'] = [
        ['name' => 'Alice', 'text' => 'บทความดีมากครับ!',      'safe' => true],
        ['name' => 'Bob',   'text' => 'ขอบคุณสำหรับข้อมูล',    'safe' => true],
    ];
}

$scenario = $_GET['scenario'] ?? '';
$action   = $_POST['action']  ?? '';

// ── บันทึก comment (Stored XSS) ─────────────────────
if ($action === 'comment') {
    $name = $_POST['name'] ?? '';
    $text = $_POST['text'] ?? '';
    $safe = isset($_POST['safe']);

    if ($safe) {
        // ✓ Escape ก่อนบันทึก
        $name = htmlspecialchars($name, ENT_QUOTES, 'UTF-8');
        $text = htmlspecialchars($text, ENT_QUOTES, 'UTF-8');
    }
    // ❌ Vulnerable: บันทึกดิบๆ

    $_SESSION['comments'][] = [
        'name' => $name,
        'text' => $text,
        'safe' => $safe,
    ];
    header('Location: ?scenario=stored');
    exit;
}

// ── ล้าง comments ─────────────────────────────────────
if ($action === 'clear') {
    $_SESSION['comments'] = [
        ['name' => 'Alice', 'text' => 'บทความดีมากครับ!',   'safe' => true],
        ['name' => 'Bob',   'text' => 'ขอบคุณสำหรับข้อมูล', 'safe' => true],
    ];
    header('Location: ?scenario=stored');
    exit;
}

// ── ค่า reflected ─────────────────────────────────────
$q_raw  = $_GET['q'] ?? '';       // ❌ ไม่ escape
$q_safe = htmlspecialchars($q_raw, ENT_QUOTES, 'UTF-8'); // ✓ escape
?>
