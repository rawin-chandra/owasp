<script>
async function hashPassword() {
    const pass = document.getElementById('testPass').value;
    const cost = document.getElementById('costSlider').value;
    const el   = document.getElementById('hashResult');

    el.style.display = 'block';
    el.textContent   = 'กำลัง hash... (อาจใช้เวลาสักครู่ตาม cost)';

    const fd = new FormData();
    fd.append('test_pass', pass);
    fd.append('cost', cost);

    const res  = await fetch('', { method:'POST', body: fd });
    const data = await res.json();

    el.textContent =
        `hash:         ${data.hash}\n` +
        `length:       ${data.length} chars\n` +
        `time_hash:    ${data.time_hash}\n` +
        `time_verify:  ${data.time_verify}\n` +
        `algorithm:    ${data.info.algoName}\n` +
        `options:      cost = ${data.info.options.cost ?? '-'}`;
}
