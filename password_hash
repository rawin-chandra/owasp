<?php
/**
 * =====================================================
 *  Password Hashing ก่อนเก็บลง Database — PHP
 * =====================================================
 *  1. bcrypt     — มาตรฐานที่แนะนำที่สุด
 *  2. Argon2id   — ทันสมัยที่สุด (PHP 7.3+)
 *  3. ตัวอย่าง Register / Login ครบวงจร
 *  4. ❌ วิธีที่ผิด — MD5, SHA1, plaintext
 * =====================================================
 */

// ─────────────────────────────────────────────────────
// 1. BCRYPT — แนะนำที่สุด สำหรับ PHP ทั่วไป
// ─────────────────────────────────────────────────────

$password = "MySecret@2025";

// ── Hash password ──────────────────────────────────
$hash = password_hash($password, PASSWORD_BCRYPT, [
    'cost' => 12   // ยิ่งสูงยิ่งช้า ยิ่งปลอดภัย (ค่า default=10)
]);
// ผลลัพธ์: $2y$12$... (60 ตัวอักษร มี salt ในตัว)
echo "bcrypt hash: $hash\n\n";

// ── Verify password ────────────────────────────────
if (password_verify($password, $hash)) {
    echo "✓ Password ถูกต้อง\n";
} else {
    echo "✗ Password ผิด\n";
}

// ── ตรวจว่า hash ต้องการ rehash ไหม ─────────────────
if (password_needs_rehash($hash, PASSWORD_BCRYPT, ['cost' => 12])) {
    $hash = password_hash($password, PASSWORD_BCRYPT, ['cost' => 12]);
    // อัปเดต hash ใหม่ลง DB
}

// ─────────────────────────────────────────────────────
// 2. ARGON2ID — ทันสมัย ป้องกัน side-channel attack
// ─────────────────────────────────────────────────────

$hash_argon = password_hash($password, PASSWORD_ARGON2ID, [
    'memory_cost' => 65536,  // 64MB
    'time_cost'   => 4,      // 4 iterations
    'threads'     => 2,      // 2 threads
]);
// ผลลัพธ์: $argon2id$v=19$... (มี salt ในตัวเช่นกัน)
echo "\nArgon2id hash: $hash_argon\n";

if (password_verify($password, $hash_argon)) {
    echo "✓ Argon2id verify ผ่าน\n";
}

// ─────────────────────────────────────────────────────
// 3. ตัวอย่าง REGISTER / LOGIN ครบวงจร
// ─────────────────────────────────────────────────────

class UserAuth
{
    private PDO $pdo;

    public function __construct(PDO $pdo)
    {
        $this->pdo = $pdo;
    }

    // ── สมัครสมาชิก ─────────────────────────────────
    public function register(string $username, string $password): bool
    {
        // 1. ตรวจความแข็งแกร่งของ password
        if (!$this->isPasswordStrong($password)) {
            throw new \InvalidArgumentException(
                "Password ต้องมีอย่างน้อย 8 ตัว มีตัวพิมพ์ใหญ่ ตัวเลข และอักขระพิเศษ"
            );
        }

        // 2. ✓ Hash password ด้วย bcrypt
        //    password_hash() สร้าง salt ใหม่ทุกครั้งอัตโนมัติ
        $hash = password_hash($password, PASSWORD_BCRYPT, ['cost' => 12]);

        // 3. บันทึกลง database (เก็บแค่ hash ไม่เก็บ password จริง!)
        $stmt = $this->pdo->prepare(
            "INSERT INTO users (username, password_hash, created_at)
             VALUES (?, ?, NOW())"
        );
        return $stmt->execute([$username, $hash]);

        // ── ข้อมูลใน DB ──────────────────────────────
        // username     | password_hash
        // bob          | $2y$12$abc...xyz  (ไม่ใช่ MySecret@2025!)
    }

    // ── เข้าสู่ระบบ ──────────────────────────────────
    public function login(string $username, string $password): ?array
    {
        // 1. ดึง hash จาก database
        $stmt = $this->pdo->prepare(
            "SELECT id, username, password_hash, role
             FROM users WHERE username = ?"
        );
        $stmt->execute([$username]);
        $user = $stmt->fetch(PDO::FETCH_ASSOC);

        if (!$user) {
            return null; // ไม่พบ username
        }

        // 2. ✓ เปรียบเทียบด้วย password_verify()
        //    ไม่ต้อง hash password ที่รับมาเอง — ฟังก์ชันจัดการให้
        if (!password_verify($password, $user['password_hash'])) {
            return null; // password ผิด
        }

        // 3. ตรวจว่าต้อง rehash ไหม (เช่น อัปเกรด cost)
        if (password_needs_rehash($user['password_hash'], PASSWORD_BCRYPT, ['cost' => 12])) {
            $newHash = password_hash($password, PASSWORD_BCRYPT, ['cost' => 12]);
            $this->pdo->prepare("UPDATE users SET password_hash=? WHERE id=?")
                      ->execute([$newHash, $user['id']]);
        }

        return $user; // login สำเร็จ
    }

    // ── เปลี่ยน password ─────────────────────────────
    public function changePassword(int $userId, string $oldPass, string $newPass): bool
    {
        $stmt = $this->pdo->prepare(
            "SELECT password_hash FROM users WHERE id = ?"
        );
        $stmt->execute([$userId]);
        $user = $stmt->fetch(PDO::FETCH_ASSOC);

        // ตรวจ password เก่าก่อนเสมอ
        if (!$user || !password_verify($oldPass, $user['password_hash'])) {
            return false;
        }

        if (!$this->isPasswordStrong($newPass)) {
            throw new \InvalidArgumentException("Password ใหม่ไม่แข็งแกร่งพอ");
        }

        $newHash = password_hash($newPass, PASSWORD_BCRYPT, ['cost' => 12]);
        $this->pdo->prepare("UPDATE users SET password_hash=? WHERE id=?")
                  ->execute([$newHash, $userId]);

        return true;
    }

    // ── ตรวจความแข็งแกร่ง password ─────────────────
    private function isPasswordStrong(string $password): bool
    {
        return strlen($password) >= 8
            && preg_match('/[A-Z]/', $password)     // ตัวพิมพ์ใหญ่
            && preg_match('/[a-z]/', $password)     // ตัวพิมพ์เล็ก
            && preg_match('/[0-9]/', $password)     // ตัวเลข
            && preg_match('/[^A-Za-z0-9]/', $password); // อักขระพิเศษ
    }
}

// ─────────────────────────────────────────────────────
// 4. ❌ วิธีที่ผิด — ห้ามใช้เด็ดขาด
// ─────────────────────────────────────────────────────

$pass = "MySecret@2025";

// ❌ เก็บ plaintext — ถ้า DB รั่วเห็น password ทันที
$wrong1 = $pass;
// INSERT INTO users (password) VALUES ('MySecret@2025')

// ❌ MD5 — crack ได้ใน วินาที (Rainbow table)
$wrong2 = md5($pass);
// → 7d2e0d9f... อ่านได้จาก crackstation.net ทันที!

// ❌ SHA1 — ยังไม่ดีพอ
$wrong3 = sha1($pass);

// ❌ SHA256 เปล่าๆ ไม่มี salt — ยังโดน Rainbow table
$wrong4 = hash('sha256', $pass);

// ❌ MD5 + salt แบบ manual — ยังผิดอยู่
$wrong5 = md5("mysalt" . $pass); // salt คงที่ = ยัง crack ได้

// ✓ ทางที่ถูก — password_hash() จัดการทุกอย่างให้
$correct = password_hash($pass, PASSWORD_BCRYPT);

echo "\n";
echo "❌ plaintext: $wrong1\n";
echo "❌ MD5:       $wrong2\n";
echo "❌ SHA1:      $wrong3\n";
echo "✅ bcrypt:    $correct\n";

// ─────────────────────────────────────────────────────
// 5. DATABASE SCHEMA
// ─────────────────────────────────────────────────────

/*
-- สร้างตาราง users
CREATE TABLE users (
    id            INT AUTO_INCREMENT PRIMARY KEY,
    username      VARCHAR(50)  NOT NULL UNIQUE,
    password_hash VARCHAR(255) NOT NULL,   -- bcrypt ใช้ 60 ตัว, เผื่อ 255
    email         VARCHAR(100) NOT NULL UNIQUE,
    role          ENUM('user','admin') DEFAULT 'user',
    created_at    DATETIME DEFAULT CURRENT_TIMESTAMP,
    updated_at    DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    INDEX idx_username (username)
);

-- ตัวอย่างข้อมูลที่เก็บจริงๆ
-- username | password_hash                              | email
-- bob      | $2y$12$HG.sFkq9m5WLz0nLj8yIee...         | bob@mail.com
--                    ↑ ไม่ใช่ password จริง!
*/

// ─────────────────────────────────────────────────────
// 6. ทดสอบแบบ interactive (สำหรับ web)
// ─────────────────────────────────────────────────────

if (php_sapi_name() !== 'cli' && isset($_POST['test_pass'])) {
    $test = $_POST['test_pass'];
    $cost = (int)($_POST['cost'] ?? 10);

    $t_start = microtime(true);
    $h = password_hash($test, PASSWORD_BCRYPT, ['cost' => $cost]);
    $t_hash  = round((microtime(true) - $t_start) * 1000, 2);

    $t_start = microtime(true);
    password_verify($test, $h);
    $t_verify = round((microtime(true) - $t_start) * 1000, 2);

    echo json_encode([
        'hash'      => $h,
        'length'    => strlen($h),
        'time_hash' => $t_hash . ' ms',
        'time_verify'=> $t_verify . ' ms',
        'info'      => password_get_info($h),
    ], JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE);
    exit;
}
