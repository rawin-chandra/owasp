        <button type="submit" class="btn-danger">ค้นหา (Vulnerable)</button>
    </form>

    <?php
    if (isset($_GET['scenario']) && $_GET['scenario'] === 'search') {
        $q = $_GET['q'] ?? '';

        // ❌ อันตราย
        $sql = "SELECT id, name, price, description FROM products WHERE name LIKE '%$q%'";

        echo "<pre>";
        echo "<span class='comment'>// SQL ที่ถูกสร้าง:</span>\n";
        echo htmlspecialchars($sql);
        echo "</pre>";

        try {
            $result = $pdo->query($sql);
            $rows   = $result->fetchAll(PDO::FETCH_ASSOC);
            if ($rows) {
                echo "<table style='width:100%;border-collapse:collapse;font-size:13px'>";
                echo "<tr style='background:#e74c3c;color:white'>";
                foreach (array_keys($rows[0]) as $col) {
                    echo "<th style='padding:8px;border:1px solid #ddd'>" . htmlspecialchars($col) . "</th>";
                }
                echo "</tr>";
                foreach ($rows as $row) {
                    echo "<tr>";
                    foreach ($row as $val) {
                        echo "<td style='padding:8px;border:1px solid #ddd'>" . htmlspecialchars($val ?? '') . "</td>";
                    }
                    echo "</tr>";
                }
                echo "</table>";
            }
        } catch (PDOException $e) {
            echo "<div class='result result-danger'>Error: " . htmlspecialchars($e->getMessage()) . "</div>";
        }
    }
    ?>

    <pre><span class="highlight">// ❌ อันตราย
$sql = "SELECT * FROM products WHERE name LIKE '%$q%'";</span>

<span class="comment">// UNION payload:
// ' UNION SELECT username,password,null,null FROM users --
// กลายเป็น:
// SELECT * FROM products WHERE name LIKE '%'
// UNION SELECT username,password,null,null FROM users --%'
// → ดึง users table ออกมาแทน!</span></pre>
</div>

