/**
 * =====================================================
 *  ตัวอย่าง SQL Injection — Vulnerable vs Safe
 * =====================================================
 *  ไฟล์นี้แสดงให้เห็นความแตกต่างระหว่าง
 *  โค้ดที่มีช่องโหว่ และโค้ดที่ปลอดภัย
 *  สำหรับการเรียนรู้เท่านั้น
 * =====================================================
 */

// ─────────────────────────────────────────────────────
// การเชื่อมต่อ Database
// ─────────────────────────────────────────────────────
$host = "localhost";
$db   = "myapp";
$user = "root";
$pass = "password";

// PDO connection (ใช้ทั้ง 2 ตัวอย่าง)
try {
    $pdo = new PDO(
        "mysql:host=$host;dbname=$db;charset=utf8",
        $user, $pass,
        [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]
    );
} catch (PDOException $e) {
    die("Connection failed");
}

// MySQLi connection
$mysqli = new mysqli($host, $user, $pass, $db);
?>
