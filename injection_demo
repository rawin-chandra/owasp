<!-- ═══════════════════════════════════════════════════
     SCENARIO 1: Login Form
════════════════════════════════════════════════════ -->
<h2>Scenario 1 — Login Form</h2>

<!-- Vulnerable -->
<div class="card danger">
    <span class="label-danger">❌ VULNERABLE</span>
    <h3 style="margin-top:0">String Concatenation — โดน inject ได้</h3>

    <div class="attack-box">
        <strong>ลอง payload นี้:</strong><br>
        Username: <code>admin' OR '1'='1' --</code><br>
        Password: <code>anything</code><br>
        <small>→ SQL จะกลายเป็น WHERE username='admin' OR '1'='1' ซึ่งเป็นจริงเสมอ</small>
    </div>

    <form method="POST" action="">
        <input type="hidden" name="action" value="login_vulnerable">
        <label>Username</label>
        <input type="text" name="vuln_user" placeholder="ลอง: admin' OR '1'='1' --">
        <label>Password</label>
        <input type="password" name="vuln_pass" placeholder="พิมพ์อะไรก็ได้">
        <button type="submit" class="btn-danger">Login (Vulnerable)</button>
    </form>

    <?php
    if (isset($_POST['action']) && $_POST['action'] === 'login_vulnerable') {
        $username = $_POST['vuln_user'];
        $password = $_POST['vuln_pass'];

        // ❌ อันตราย: ต่อ string โดยตรง
        $sql = "SELECT * FROM users
                WHERE username = '$username'
                AND password = '$password'";

        echo "<pre>";
        echo "<span class='comment'>// SQL ที่ถูกสร้างขึ้น:</span>\n";
        echo htmlspecialchars($sql);
        echo "</pre>";

        try {
            $result = $pdo->query($sql);
            $user   = $result->fetch(PDO::FETCH_ASSOC);

            if ($user) {
                echo "<div class='result result-danger'>
                    ⚠️ Login สำเร็จ! พบ user: <strong>" . htmlspecialchars($user['username'] ?? 'unknown') . "</strong>
                    (role: " . htmlspecialchars($user['role'] ?? '-') . ")
                    <br><small>attacker เข้าได้โดยไม่รู้รหัสผ่าน!</small>
                </div>";
            } else {
                echo "<div class='result result-safe'>ไม่พบ user</div>";
            }
        } catch (PDOException $e) {
            echo "<div class='result result-danger'>Error: " . htmlspecialchars($e->getMessage()) . "</div>";
        }
    }
    ?>

    <pre><span class="comment">// โค้ดที่มีช่องโหว่:</span>
<span class="highlight">$sql = "SELECT * FROM users
        WHERE username = '$username'
        AND password = '$password'";</span>

<span class="comment">// ถ้า username = admin' OR '1'='1' --
// SQL กลายเป็น:
// SELECT * FROM users WHERE username='admin' OR '1'='1' --' AND password='x'
// '1'='1' เป็นจริงเสมอ → ดึง user ทุกคนออกมา!</span></pre>
</div>

<!-- Safe -->
<div class="card safe">
    <span class="label-safe">✅ SAFE</span>
    <h3 style="margin-top:0">Prepared Statement — ปลอดภัย</h3>

    <form method="POST" action="">
        <input type="hidden" name="action" value="login_safe">
        <label>Username</label>
        <input type="text" name="safe_user" placeholder="ลอง: admin' OR '1'='1' --">
        <label>Password</label>
        <input type="password" name="safe_pass" placeholder="พิมพ์อะไรก็ได้">
        <button type="submit" class="btn-safe">Login (Safe)</button>
    </form>

    <?php
    if (isset($_POST['action']) && $_POST['action'] === 'login_safe') {
        $username = $_POST['safe_user'];
        $password = $_POST['safe_pass'];

        // ✓ ปลอดภัย: Prepared Statement
        $stmt = $pdo->prepare(
            "SELECT * FROM users WHERE username = ? AND password = ?"
        );
        $stmt->execute([$username, $password]);
        $user = $stmt->fetch(PDO::FETCH_ASSOC);

        echo "<pre>";
        echo "<span class='comment'>// SQL template (ไม่เปลี่ยนแปลง):</span>\n";
        echo "SELECT * FROM users WHERE username = ? AND password = ?\n";
        echo "<span class='comment'>// Parameters ที่ส่ง (treated as data เสมอ):</span>\n";
        echo "['" . htmlspecialchars($username) . "', '" . htmlspecialchars($password) . "']";
        echo "</pre>";

        if ($user) {
            echo "<div class='result result-safe'>
                Login สำเร็จ: <strong>" . htmlspecialchars($user['username'] ?? '') . "</strong>
            </div>";
        } else {
            echo "<div class='result result-safe'>
                ✓ ไม่พบ user — payload ถูกมองเป็นข้อความ ไม่ใช่ SQL
            </div>";
        }
    }
    ?>

    <pre><span class="comment">// โค้ดที่ปลอดภัย (PDO):</span>
<span class="good">$stmt = $pdo->prepare(
    "SELECT * FROM users WHERE username = ? AND password = ?"
);
$stmt->execute([$username, $password]);</span>

<span class="comment">// หรือ Named Parameters (อ่านง่ายกว่า):</span>
<span class="good">$stmt = $pdo->prepare(
    "SELECT * FROM users WHERE username = :user AND password = :pass"
);
$stmt->execute([':user' => $username, ':pass' => $password]);</span></pre>
</div>

